# Copy this file to .env and change the local passwords.

# MySQL container
MYSQL_PORT=3306
DB_NAME=file_guard
DB_USERNAME=file_guard
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

# Spring Boot datasource
DB_URL=jdbc:mysql://localhost:3306/file_guard?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SERVER_PORT=8080

# Upload
MAX_FILE_SIZE=10MB
MAX_MULTIPART_FILE_SIZE=11MB
MAX_REQUEST_SIZE=12MB
UPLOAD_DIR=./uploads

# ClamAV container
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10000

# Frontend
FRONTEND_URL=http://localhost:5173
