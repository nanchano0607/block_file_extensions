# EC2 서버의 프로젝트 디렉토리(예: /opt/fileguard/.env)에 이 내용을 참고해 직접 작성한다.
# 이 파일 자체(.env.production.example)는 예시일 뿐이며 실제 비밀값을 담지 않는다.
# docker-compose.prod.yml과 같은 디렉토리에 .env로 저장하면 docker compose가 자동으로 읽는다.

# Docker Hub에서 받아올 이미지
DOCKERHUB_NAMESPACE=kimchano
IMAGE_TAG=latest

# MySQL
DB_NAME=file_guard
DB_USERNAME=file_guard
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

# 업로드 제한 (spec.md 4-0: 업무 기준 10MB, Spring 보호 상한 11MB/12MB)
MAX_FILE_SIZE=10MB
MAX_MULTIPART_FILE_SIZE=11MB
MAX_REQUEST_SIZE=12MB

# ClamAV 스캔 타임아웃(ms)
CLAMAV_TIMEOUT=10000
